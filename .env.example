# Supabase Authentication (Required)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Python AI Backend Connection (Required)
NEXT_PUBLIC_PYTHON_SERVER_URL=http://localhost:8000

# OpenRouter / LLaMA 3.1 AI Copilot (Optional but recommended for Chatbot)
NEXT_PUBLIC_OPENROUTER_API_KEY=your_openrouter_api_key

# Twilio WhatsApp Alerts Configuration (Optional for SOS Alerts)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=your_twilio_whatsapp_number
TWILIO_TO_NUMBER=your_personal_whatsapp_number
